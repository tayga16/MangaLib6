#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    if [ -x /usr/bin/uicache ]; then
        # iOS 5 uicache has no -p option. Run as mobile to update its app list.
        if command -v su >/dev/null 2>&1; then
            su mobile -c /usr/bin/uicache || /usr/bin/uicache
        else
            /usr/bin/uicache
        fi
    fi
fi
exit 0
